{
  "name": "@a2aregistry/validate",
  "version": "1.0.0",
  "description": "CLI and library validator for Agent-to-Agent (A2A) Protocol v1.0 agent cards. Pure protocol compliance — no registry-specific logic. Runs fully offline.",
  "bin": {
    "a2a-validate": "./bin/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cf": "./src/schema-only.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "a2a",
    "agent-card",
    "validator",
    "ai-agents",
    "linux-foundation",
    "offline",
    "cli"
  ],
  "author": "A2A Registry Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/compile-schema.mjs",
    "prepublishOnly": "node scripts/compile-schema.mjs",
    "test": "node test/security.test.js && node test/cli.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jose": "^5.10.0",
    "json-canonicalize": "^1.2.0"
  }
}
